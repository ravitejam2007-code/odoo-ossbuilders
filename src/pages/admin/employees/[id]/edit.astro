---
import Layout from '../../../../layouts/Layout.astro';
import { EmployeeEditPage } from '../../../../admin/pages/EmployeeEditPage';
import { MOCK_ADMIN_EMPLOYEES } from '../../../../admin/api/mockData';

export function getStaticPaths() {
  return MOCK_ADMIN_EMPLOYEES.map((emp) => ({
    params: { id: emp.id },
  }));
}

const { id } = Astro.params;
---

<Layout title="Edit Employee — Dayflow Admin HRMS">
  <EmployeeEditPage client:only="react" id={id || ''} />
</Layout>
